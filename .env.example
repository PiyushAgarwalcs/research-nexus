# ============================================================
# ResearchNexus — Environment Configuration
# ============================================================

# OpenAI API Key (Required for dense embeddings, answer generation, and evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Directory containing scientific papers (default: ./data/)
DATA_DIR=./data/

# Model Selection for Reranking: 'finetuned' (default) or 'pretrained'
RERANKER_MODEL=finetuned

# Pretrained Hugging Face cross-encoder model identifier
PRETRAINED_RERANKER_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional path override for fine-tuned checkpoint (auto-detected in Notebook/ by default)
# FINETUNED_RERANKER_PATH=./Notebook/researchnexus-finetuning/minilm-scifact-finetuned

# Generator & Judge LLMs
GENERATOR_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Hybrid Retrieval Weights (Dense + BM25)
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RETRIEVAL_DEPTH=60
RRF_K=60
TOP_N=20
FINAL_K=5

# Confidence & Verification Thresholds
CONFIDENCE_THRESHOLD=0.75

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
